SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
# NUNCA exponha esta chave no front end nem suba no Git (ela ignora o RLS)
SUPABASE_SERVICE_ROLE_KEY=
# Só para projetos com JWT legado (HS256). Se vazio, usa as chaves públicas (JWKS) do projeto.
SUPABASE_JWT_SECRET=
# Lista em JSON
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Em desenvolvimento: confirma o e-mail automaticamente no cadastro
AUTO_CONFIRMAR_EMAIL=true
OPEN_API_KEY=your_open_api_key_here
